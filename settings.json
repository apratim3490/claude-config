{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoUpdatesChannel": "latest",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/context-handover.js\""
          }
        ],
        "description": "Track context usage and trigger handover at ~75% capacity"
      }
    ]
  }
}
