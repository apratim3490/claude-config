{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "(python3 -c \"import os,runpy;runpy.run_path(os.path.join(os.path.expanduser('~'),'.claude','hooks','init-read-claudemd.py'),run_name='__main__')\" 2>/dev/null || python -c \"import os,runpy;runpy.run_path(os.path.join(os.path.expanduser('~'),'.claude','hooks','init-read-claudemd.py'),run_name='__main__')\")"
          }
        ],
        "description": "Read CLAUDE.md files on first tool call of each session"
      }
    ]
  },
  "autoUpdatesChannel": "latest"
}
