{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$(python3 --version >/dev/null 2>&1 && echo python3 || echo python) -c \"import os,runpy;runpy.run_path(os.path.join(os.path.expanduser('~'),'.claude','hooks','init-read-claudemd.py'),run_name='__main__')\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$(python3 --version >/dev/null 2>&1 && echo python3 || echo python) -c \"import os,runpy;runpy.run_path(os.path.join(os.path.expanduser('~'),'.claude','hooks','context-handover.py'),run_name='__main__')\""
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "latest"
}
